@page "/"
@rendermode RenderMode.InteractiveServer

<ViewPort id="viewport">

    <LeftResizable id="left"
                   size="25%"
                   centerContent="@CenterType.HorizontalVertical"
                   style="background-color: #eeeeff;">
        Left
    </LeftResizable>

    <Fill id="main">
        <TopResizable id="top"
                      size="25%"
                      centerContent="@CenterType.HorizontalVertical"
                      style="background-color: #eeffee;">
            Top
        </TopResizable>

        <Fill id="inner-main"
              centerContent="@CenterType.HorizontalVertical">
            Fill
        </Fill>
        <BottomResizable id="bottom"
                         size="25%"
                         centerContent="@CenterType.HorizontalVertical"
                         style="background-color: #eeffee;">
            Top
        </BottomResizable>

    </Fill>

    <RightResizable id="right"
                    size="25%"
                    centerContent="@CenterType.HorizontalVertical"
                    style="background-color: #eeeeff;">
        Right
    </RightResizable>

</ViewPort>